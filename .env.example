NODE_ENV=production
PORT=3000
LOG_LEVEL=info

BOT_TOKEN=change_me
WEBHOOK_SECRET=change_me_very_secret
WEBHOOK_PATH=/webhooks/max

EXTERNAL_DATABASE_URL=postgres://external_user:external_password@external-db-host:5432/external_db

ADMIN_MAX_IDS=12345,67890

ACT_STORAGE_DIR=/app/storage/acts
OFFER_STORAGE_DIR=/app/storage/offers
ACT_TEMPLATE_DIR=/app/template
# ACT_TEMPLATE_FILE=/app/template/your-template.xlsx
ACT_XLSX_STORAGE_DIR=/app/storage/acts/xlsx
WORKER_POLL_INTERVAL_MS=2000
LIBREOFFICE_BIN=soffice
